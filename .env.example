# Copy this file to .env (project root) and fill in your own values. Never commit .env.

# YouTube Data API v3 key(s), comma-separated. The backend rotates to the next key
# when one runs out of daily quota (quota resets at midnight Pacific).
YOUTUBE_API_KEYS=YOUR_YOUTUBE_API_KEY_HERE,YOUR_SECOND_KEY_HERE

# ID of the Google Sheet used for de-duplication and as the "Needs Email" queue
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE

# Groq API key: the LLM picks the next video in "Hop with AI" mode
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# Optional: override the Groq model
# GROQ_MODEL=openai/gpt-oss-20b

# Email scraper: Gmail accounts (comma-separated) whose logged-in Chrome profiles
# are used to reveal YouTube "business inquiries" emails, and where those profiles live
GMAIL_ACCOUNTS=you@example.com,you2@example.com
CHROME_PROFILES_DIR=C:\path\to\chrome_profiles

# The Google service-account JSON is NOT an env var: save it as
#   backend/keys/google-service-account.json   (backend/keys/ is gitignored)
# and share your Google Sheet with the service account's client_email.
